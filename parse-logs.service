# Need to replace the following fields:
# <serviceuser> ... take not the user root for
# <file> ... the access log file from the 389-ds
# <optional-params> ... what ever you need ...

[Unit]
Description=Log Parser for 389-ds logs
Wants=network.target network-online.target nfs-client.target rsyslog.service
After=network.target network-online.target nfs-client.target rsyslog.service

[Service]
Type=simple
User=<serviceuser>
Group=<serviceuser>
PrivateTmp=true

# state file and lastbind db are stored in /var/lib/parse-logs/
StateDirectory=parse-logs

WorkingDirectory=/opt/parse-logs/
ExecStart=/usr/bin/env /usr/bin/python3 /opt/parse-logs/parse-logs.py --log_input=<file>.log --state_file=/var/lib/parse-logs/state.json --lastbind_db=/var/lib/parse-logs/lastbind.db <optional-params>
ExecReload=/bin/kill -HUP $MAINPID
TimeoutSec=10

Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
